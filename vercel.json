{
  "buildCommand": "pnpm --filter @workspace/itech-network-africa run build",
  "outputDirectory": "artifacts/itech-network-africa/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "itechnetworkafrica.com"
        }
      ],
      "destination": "https://www.itechnetworkafrica.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|sitemap\\.xml$|robots\\.txt$|site\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
